# App Settings
APP_NAME=Problem Intelligence OS API
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL 16 via Docker)
# Format: postgresql+psycopg://user:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/problem_intelligence

# Security & Background Services
SECRET_KEY=change_this_to_a_secure_random_string_in_production
REDIS_URL=redis://localhost:6379

# External APIs & LLM Providers (Sprint 3+)
OPENAI_API_KEY=
